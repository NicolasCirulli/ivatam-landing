---
import { SITE } from "../config/site";

const currentYear = new Date().getFullYear();
const LINKS = [
  { name: "Inicio", href: "#inicio" },
  { name: "Servicios", href: "#servicios" },
  { name: "Productos", href: "#productos" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Contacto", href: "#contacto" },
];
---

<footer class="w-full bg-slate-950 text-slate-300 pt-16 pb-8 px-5 lg:px-10 border-t border-slate-900">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
    
    <!-- Columna 1: Marca y Descripción -->
    <div class="flex flex-col gap-4">
      <h2 class="font-extrabold text-3xl text-white tracking-tight">IVATAM</h2>
      <p class="text-slate-400 leading-relaxed max-w-sm">
        Especialistas en frenos, suspensión y tren delantero. Brindamos repuestos de primeras marcas y servicio técnico de confianza para que vuelvas a la ruta con total tranquilidad.
      </p>
    </div>

    <!-- Columna 2: Navegación Rápida -->
    <div class="flex flex-col gap-4 md:ml-auto">
      <h3 class="font-bold text-lg text-white mb-2">Navegación Rápida</h3>
      <nav class="flex flex-col gap-3">
        {
          LINKS.map((link) => (
            <a
              class="text-slate-400 hover:text-emerald-400 transition-colors w-fit"
              href={link.href}
            >
              {link.name}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Columna 3: Contacto y Horarios -->
    <div class="flex flex-col gap-4 md:ml-auto">
      <h3 class="font-bold text-lg text-white mb-2">Contacto y Horarios</h3>
      <address class="not-italic flex flex-col gap-3 text-slate-400">
        <p class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          {SITE.address}<br/>{SITE.city}, {SITE.province}
        </p>
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          <a href={SITE.phoneTel} class="hover:text-emerald-400 transition-colors">{SITE.phoneDisplay}</a>
        </p>
        <p class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          {SITE.hours}
        </p>
      </address>
    </div>
    
  </div>

  <!-- Barra Inferior (Copyright) -->
  <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row justify-center items-center">
    <p class="text-sm text-slate-500 text-center">
      &copy; {currentYear} IVATAM. Todos los derechos reservados.
    </p>
  </div>
</footer>
