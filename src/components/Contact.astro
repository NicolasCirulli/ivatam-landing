<section id="contacto" class="py-24 px-5 lg:px-10 bg-white text-slate-900">
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="text-4xl font-extrabold mb-6">Ubicación y Contacto</h2>
    <p class="text-lg text-slate-600 mb-10 max-w-2xl mx-auto">
      Visítanos en nuestro local o comunícate directamente por WhatsApp para consultas de stock, presupuestos o turnos para el taller.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center items-center gap-6 mb-16">
      <!-- TODO: Reemplazar '1234567890' con el número de WhatsApp real (código de país sin el '+', ej: 54911...) -->
      <a href="https://wa.me/1234567890" target="_blank" rel="noopener noreferrer" class="bg-emerald-600 text-white font-bold py-4 px-8 rounded-lg shadow-md hover:bg-emerald-700 hover:shadow-lg transition-all w-full sm:w-auto">
        Escribir por WhatsApp
      </a>
      <!-- TODO: Reemplazar '+1234567890' con el número de teléfono real -->
      <a href="tel:+1234567890" class="bg-slate-100 text-slate-800 border border-slate-300 font-bold py-4 px-8 rounded-lg hover:bg-slate-200 transition-colors w-full sm:w-auto">
        Llamar por Teléfono
      </a>
    </div>

    <div class="bg-slate-100 h-[400px] w-full rounded-xl flex items-center justify-center border border-slate-200 shadow-inner overflow-hidden relative">
      <iframe 
        src="https://maps.google.com/maps?q=Calle%20Santa%20Cruz%20710,%20Ezpeleta,%20Buenos%20Aires,%20Argentina&t=&z=15&ie=UTF8&iwloc=&output=embed" 
        class="absolute top-0 left-0 w-full h-full border-0" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación de Ivatam en Google Maps">
      </iframe>
    </div>
    
    <div class="mt-6 text-slate-600">
      <p class="font-bold text-xl text-slate-800">Calle Santa Cruz 710</p>
      <p class="text-md mt-1">Ezpeleta, Buenos Aires, Argentina</p>
      <p class="text-sm mt-2 text-slate-500">Lunes a Viernes de 8:00 a 18:00 hs</p>
    </div>
  </div>
</section>
