---
const services = [
  { 
    title: "Tren Delantero", 
    description: "Revisión y recambio de piezas para una dirección precisa y estable.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  },
  { 
    title: "Frenos", 
    description: "Cambio de pastillas, discos y líquido de frenos garantizando la máxima seguridad.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  },
  { 
    title: "Embrague", 
    description: "Sustitución de kits de embrague completos para una transmisión suave y eficiente.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>`
  },
];
---

<section id="servicios" class="py-20 px-5 lg:px-10 bg-slate-50 text-slate-900 border-b border-slate-200">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-extrabold mb-4">Nuestras Especialidades</h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">Soluciones técnicas precisas para el rendimiento óptimo de tu vehículo.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {services.map(s => (
        <div class="group p-8 lg:p-10 bg-white border border-slate-200 rounded-2xl shadow-md border-b-4 border-b-transparent hover:border-b-emerald-500 hover:-translate-y-2 hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-emerald-100 transition-transform duration-300" set:html={s.icon} />
          <h3 class="text-2xl font-bold mb-4 text-slate-800 group-hover:text-emerald-700 transition-colors">{s.title}</h3>
          <p class="text-slate-600 leading-relaxed">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
