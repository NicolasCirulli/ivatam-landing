---
import { SITE } from "../config/site";
---

<section
  id="inicio"
  class="relative flex flex-col lg:grid grid-cols-[minmax(0,1fr)_minmax(360px,512px)] gap-10 items-center bg-slate-950 text-white px-5 lg:px-10 py-10 sm:py-14 lg:py-24 scroll-mt-16"
>
  <img
    alt=""
    aria-hidden="true"
    class="w-full h-full object-cover opacity-20 mix-blend-luminosity absolute top-0 left-0"
    src="/hero-bg.jpg"
    width="760"
    height="600"
    fetchpriority="high"
  />
  <article class="flex w-full max-w-3xl flex-col z-10 lg:max-w-none">
    <div class="z-40">
      <div>
        <span
          class="text-xs uppercase tracking-widest border-t border-b border-emerald-600 py-1 font-bold mb-6 inline-block text-emerald-400"
        >
          FRENOS Y SUSPENSIÓN | ASESORÍA TÉCNICA
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-6 text-zinc-50 leading-[1.08] text-balance">
        REPUESTOS Y TALLER AUTOMOTOR EN EZPELETA
      </h1>

      <p class="text-lg sm:text-xl max-w-prose mb-6 text-slate-300 leading-relaxed">
        Especialistas en frenos, suspensión, tren delantero y embrague. Encontrá
        el repuesto indicado y, si lo necesitás, realizamos la instalación en
        nuestro taller.
      </p>

      <ul class="mb-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-slate-300" aria-label="Beneficios del servicio">
        <li class="flex items-center gap-2"><span class="text-emerald-400" aria-hidden="true">●</span> Primeras marcas</li>
        <li class="flex items-center gap-2"><span class="text-emerald-400" aria-hidden="true">●</span> Asesoramiento técnico</li>
        <li class="flex items-center gap-2"><span class="text-emerald-400" aria-hidden="true">●</span> Venta e instalación</li>
      </ul>

      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-4">
        <a
          class="flex min-h-14 items-center justify-center bg-emerald-600 text-white hover:bg-emerald-500 font-bold py-4 px-6 sm:px-8 rounded-lg shadow-lg transition-colors text-base sm:text-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400"
          href={SITE.whatsapp} target="_blank" rel="noopener noreferrer"
          aria-label="Consultar stock por WhatsApp, se abre en una pestaña nueva"
        >
          CONSULTAR STOCK POR WHATSAPP
        </a>

        <a
          class="text-white border-2 flex min-h-14 items-center justify-center px-6 sm:px-8 py-4 rounded-lg font-bold border-slate-600 hover:bg-slate-800 hover:border-slate-400 transition-colors text-base sm:text-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          href="#contacto"
        >
          VER UBICACIÓN
        </a>
      </div>
    </div>
  </article>

  <img
    class="hidden lg:block w-full h-[500px] object-cover rounded-xl shadow-2xl z-10 border border-slate-800"
    src="/hero_stock.webp"
    alt="Servicio de frenos y suspensión"
    width="700"
    height="700"
    fetchpriority="high"
  />
</section>
