---
// Configuración de marcas (Placeholder)
// Edita este array cuando tengas las marcas reales.
// Si usas imágenes locales, colócalas en public/ y referéncialas (ej: '/marca1.svg').
const BRANDS = [
  {
    name: "Peugeot",
    logoUrl: "peugeot.png",
  },
  {
    name: "Renault",
    logoUrl: "renault.png",
  },
  {
    name: "Fiat",
    logoUrl: "fiat.png",
  },
  {
    name: "Toyota",
    logoUrl: "toyota.png",
  },
  {
    name: "Chevrolet",
    logoUrl: "chevrolet.png",
  },
  {
    name: "Ford",
    logoUrl: "ford.png",
  },
  {
    name: "Volkswagen",
    logoUrl: "volkswagen.png",
  },
];

// Duplicamos el array varias veces para lograr el efecto infinito sin cortes en pantallas grandes
const CAROUSEL_ITEMS = [...BRANDS, ...BRANDS, ...BRANDS, ...BRANDS];
---

<section class="w-full bg-white border-y border-slate-200 py-6 overflow-hidden">
  <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
    {
      CAROUSEL_ITEMS.map((brand, index) => (
        <div class="flex items-center justify-center px-8 lg:px-16 w-48 shrink-0 transition-all duration-300">
          <img
            src={brand.logoUrl}
            alt={`Logo de la marca ${brand.name}`}
            class="h-12 lg:h-12 w-12 object-contain pointer-events-none"
            loading="lazy"
          />
          <span class="sr-only">{brand.name}</span>
        </div>
      ))
    }
  </div>
</section>
