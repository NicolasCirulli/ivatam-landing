---
const BRANDS = [
  {
    name: "Peugeot",
    logoUrl: "/Peugeot.svg",
  },
  {
    name: "Renault",
    logoUrl: "/Renault.svg",
  },
  {
    name: "Fiat",
    logoUrl: "/Fiat.svg",
  },
  {
    name: "Toyota",
    logoUrl: "/Toyota.svg",
  },
  {
    name: "Chevrolet",
    logoUrl: "/Chevrolet.svg",
  },
  {
    name: "Ford",
    logoUrl: "/Ford.svg",
  },
  {
    name: "Volkswagen",
    logoUrl: "/Volkswagen.svg",
  },
];

// Una segunda copia alcanza para lograr el loop infinito del marquee.
// Las copias se ocultan de los lectores de pantalla.
const CAROUSEL_ITEMS = [...BRANDS, ...BRANDS];
---

<section class="w-full bg-white border-y border-slate-200 py-6 overflow-hidden" aria-label="Marcas de vehículos con las que trabajamos">
  <div class="brands-track flex w-max animate-marquee hover:[animation-play-state:paused]">
    {
      CAROUSEL_ITEMS.map((brand, index) => (
        <div
          class="flex items-center justify-center px-8 lg:px-16 w-48 shrink-0 transition-all duration-300"
          aria-hidden={index >= BRANDS.length ? "true" : undefined}
        >
          <img
            src={brand.logoUrl}
            alt={`Logo de la marca ${brand.name}`}
            class="h-12 lg:h-12 w-12 object-contain pointer-events-none"
            loading="lazy"
            width="48"
            height="48"
          />
        </div>
      ))
    }
  </div>
</section>
