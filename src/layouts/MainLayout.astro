---
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
const LINKS = [
  { name: "Inicio", href: "#inicio" },
  { name: "Servicios", href: "#servicios" },
  { name: "Productos", href: "#productos" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Contacto", href: "#contacto" },
];
---

<html lang="es" class="scroll-smooth">
  <head>
    <SEO title={title} />
  </head>
  <body class="text-slate-900 bg-white overflow-x-hidden">
    <div class="flex flex-col min-h-screen w-full">
      <header
        class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md flex justify-between items-center px-5 lg:px-10 py-4 shadow-sm"
      >
        <h2 class="font-bold text-2xl tracking-tight"><a href="#inicio">IVATAM</a></h2>
        <nav class="hidden md:flex gap-6">
          {
            LINKS.map((link) => (
              <a
                class="font-semibold uppercase text-sm tracking-wide text-slate-600 hover:text-slate-900 transition-colors"
                href={link.href}
              >
                {link.name}
              </a>
            ))
          }
        </nav>
      </header>
      <main class="flex-1 w-full min-w-0 overflow-x-hidden">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
