---
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site";
const { title } = Astro.props;
const LINKS = [
  { name: "Inicio", href: "#inicio" },
  { name: "Servicios", href: "#servicios" },
  { name: "Productos", href: "#productos" },
  { name: "Nosotros", href: "#nosotros" },
  { name: "Contacto", href: "#contacto" },
];
---

<html lang="es" class="scroll-smooth">
  <head>
    <SEO title={title} />
  </head>
  <body class="text-slate-900 bg-white overflow-x-clip">
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-white focus:px-4 focus:py-3 focus:font-bold focus:text-slate-950 focus:shadow-xl"
    >
      Saltar al contenido
    </a>
    <div class="flex flex-col min-h-screen w-full">
      <header
        class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md flex justify-between items-center px-5 lg:px-10 py-4 shadow-sm"
      >
        <span class="font-bold text-2xl tracking-tight"><a href="#inicio" aria-label="IVATAM, ir al inicio">IVATAM</a></span>
        <nav class="hidden md:flex gap-6">
          {
            LINKS.map((link) => (
              <a
                class="font-semibold uppercase text-sm tracking-wide text-slate-600 hover:text-slate-900 transition-colors"
                href={link.href}
              >
                {link.name}
              </a>
            ))
          }
        </nav>

        <details id="mobile-menu" class="relative md:hidden">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-300 text-slate-800 transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
            aria-label="Abrir menú de navegación"
          >
            <span aria-hidden="true" class="text-2xl leading-none">☰</span>
          </summary>
          <nav
            aria-label="Navegación móvil"
            class="absolute right-0 top-14 min-w-56 overflow-hidden rounded-xl border border-slate-200 bg-white p-2 shadow-xl"
          >
            {
              LINKS.map((link) => (
                <a
                  class="block rounded-lg px-4 py-3 font-semibold text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-emerald-600"
                  href={link.href}
                >
                  {link.name}
                </a>
              ))
            }
          </nav>
        </details>
      </header>
      <main id="contenido-principal" class="flex-1 w-full min-w-0 overflow-x-hidden" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <a
      href={SITE.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-4 left-4 right-4 z-40 flex min-h-14 items-center justify-center rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white shadow-xl transition-colors hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 md:hidden"
      aria-label="Consultar por WhatsApp, se abre en una pestaña nueva"
    >
      Consultar por WhatsApp
    </a>

    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>("#mobile-menu");

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => mobileMenu.removeAttribute("open"));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") mobileMenu?.removeAttribute("open");
      });
    </script>
  </body>
</html>
